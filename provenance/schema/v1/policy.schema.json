{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signthos.dev/provenance/schema/v1/policy.schema.json",
  "title": "Signthos provenance policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "policy_type", "policy_version", "rules"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "policy" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "policy_type": { "type": "string", "enum": ["license", "restricted_paths"] },
    "policy_version": { "type": "integer", "minimum": 1 },
    "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "effect"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
        "effect": {
          "type": "string",
          "enum": ["allow", "deny", "require_permission", "reject_expression"]
        },
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "path_prefix": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:/)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*//$).+$"
        },
        "expression": { "type": "string", "minLength": 1, "maxLength": 256 },
        "permission_scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "copy",
              "modify",
              "create_derivative",
              "redistribute",
              "publish_source",
              "sublicense",
              "relicense",
              "commercial_use"
            ]
          }
        }
      }
    }
  }
}
