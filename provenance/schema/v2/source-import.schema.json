{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signthos.dev/provenance/schema/v2/source-import.schema.json",
  "title": "Signthos source import record v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "classification",
    "upstream",
    "license",
    "permission",
    "distribution",
    "import",
    "transformation",
    "review"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "kind": { "const": "source_import" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$" },
    "classification": {
      "type": "string",
      "enum": ["oss_permitted", "separate_permission_required", "restricted", "unknown"]
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "path", "sha256", "copyright_holder"],
      "properties": {
        "repository": { "type": "string", "pattern": "^(?!\\.{1,2}/)(?![A-Za-z0-9_.-]+/\\.{1,2}$)[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "copyright_holder": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "license": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["classification", "spdx", "evidence"],
          "properties": {
            "classification": { "const": "spdx" },
            "spdx": { "type": "string", "minLength": 1, "maxLength": 256 },
            "evidence": { "$ref": "#/$defs/evidence" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["classification", "evidence"],
          "properties": {
            "classification": { "const": "unresolved_conflict" },
            "evidence": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 512 }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["classification", "evidence"],
          "properties": {
            "classification": { "const": "unresolved_unknown" },
            "evidence": { "$ref": "#/$defs/evidence" }
          }
        }
      ]
    },
    "permission": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact", "scope"],
          "properties": {
            "artifact": { "type": "string", "minLength": 1, "maxLength": 512 },
            "scope": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "copy",
                  "modify",
                  "create_derivative",
                  "redistribute",
                  "publish_source",
                  "sublicense",
                  "relicense",
                  "commercial_use"
                ]
              }
            }
          }
        }
      ]
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "evidence", "required_artifacts"],
      "properties": {
        "state": { "type": "string", "enum": ["resolved", "unresolved"] },
        "evidence": { "$ref": "#/$defs/evidence" },
        "required_artifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativePath" }
        }
      }
    },
    "import": {
      "type": "object",
      "additionalProperties": false,
      "required": ["destination", "sha256", "date"],
      "properties": {
        "destination": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    },
    "transformation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "notes", "derives_from"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["copied", "adapted", "rewritten_with_source_reference", "generated_from_upstream"]
        },
        "notes": { "type": "string", "maxLength": 2048 },
        "derives_from": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$" }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "pull_request", "evidence"],
      "properties": {
        "status": { "type": "string", "enum": ["pending", "qualified_exact_head", "rejected"] },
        "pull_request": { "type": "integer", "minimum": 1 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^github:(issue-comment|pull-request-review|pull-request-review-comment):[1-9][0-9]*$"
          }
        }
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:/)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*[/]$).+$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
